PREFIX era: <http://data.europa.eu/949/>
PREFIX geo: <http://www.opengis.net/ont/geosparql#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

SELECT DISTINCT ?sol ?startWKT ?endWKT ?track ?gp ?gpLabel
WHERE {
    ?sol a era:SectionOfLine .
    ?sol (era:hasPart|era:track) ?track .

    # Resolve direct and canonical OP links, with optional network references.
    ?sol era:opStart/(^era:canonicalURI)?/(era:netReference)?/geo:hasGeometry/geo:asWKT ?startWKT .
    ?sol era:opEnd/(^era:canonicalURI)?/(era:netReference)?/geo:hasGeometry/geo:asWKT ?endWKT .

    # Include parameters from shared sets and their parent sets.
    ?track (era:belongsTo/era:subsetOf*)?/era:gaugingProfile ?gp .
    OPTIONAL {
        ?gp skos:prefLabel ?gpLabel .
        FILTER(LANGMATCHES(LANG(?gpLabel), 'en') || LANG(?gpLabel) = '')
    }
}
